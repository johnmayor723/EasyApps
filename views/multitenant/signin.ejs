<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="icon" type="image/svg+xml" href="/multitenant/img/easyicon.svg"/>
  <title>Log in | EasyHostNet</title>

  <style>
    :root {
      --bg: #0a0e14;
      --bg-glow: #0d3d38;
      --ink: #f5f7fa;
      --muted: #8890a0;
      --line: #232a35;
      --field-bg: #11161f;
      --accent: #2dd4bf;
      --accent-strong: #0d9488;
      --accent-strong-hover: #0f766e;
      --danger: #f0847d;
      --danger-soft: #3a1a19;
      --ok: #3fd18c;
      --ok-soft: #113222;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100vh;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      display: flex;
      flex-direction: column;
      background-image: radial-gradient(560px 360px at 50% -8%, var(--bg-glow), transparent 70%);
      background-repeat: no-repeat;
    }

    a { color: inherit; }

    /* Top bar */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 28px;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: ui-monospace, "JetBrains Mono", "Fira Code", "IBM Plex Mono", Menlo, Consolas, monospace;
      font-weight: 600;
      font-size: 17px;
      text-decoration: none;
    }

    .brand span { color: var(--accent); }

    .topbar-link {
      font-size: 13.5px;
      color: var(--muted);
      text-decoration: none;
    }

    .topbar-link strong {
      color: var(--ink);
      font-weight: 600;
      margin-left: 4px;
    }

    /* Hero + form */
    .hero {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 24px 20px 64px;
    }

    .hero h1 {
      font-family: ui-monospace, "JetBrains Mono", "Fira Code", "IBM Plex Mono", Menlo, Consolas, monospace;
      font-weight: 600;
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.15;
      margin: 0 0 10px;
      letter-spacing: -0.01em;
    }

    .hero-sub {
      color: var(--muted);
      font-size: 15px;
      max-width: 40ch;
      margin: 0 0 36px;
      line-height: 1.55;
    }

    .login-form {
      width: 100%;
      max-width: 360px;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .field label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 6px;
      letter-spacing: 0.01em;
    }

    .field input {
      width: 100%;
      background: var(--field-bg);
      border: 1px solid var(--line);
      color: var(--ink);
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 14.5px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .field input::placeholder {
      color: #545c6b;
    }

    .field input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.15);
    }

    .btn-submit {
      margin-top: 6px;
      background: var(--accent-strong);
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 13px 20px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .btn-submit:hover {
      background: var(--accent-strong-hover);
    }

    .alert {
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13.5px;
    }

    .alert-success {
      background: var(--ok-soft);
      color: var(--ok);
    }

    .alert-danger {
      background: var(--danger-soft);
      color: var(--danger);
    }

    .form-links {
      display: flex;
      justify-content: space-between;
      margin-top: 4px;
      font-size: 13px;
      color: var(--muted);
    }

    .form-links a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .signup-cta {
      margin-top: 28px;
      font-size: 13.5px;
      color: var(--muted);
    }

    .signup-cta a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    @media (max-width: 480px) {
      .topbar { padding: 18px 20px; }
      .topbar-link span { display: none; }
    }
  </style>
</head>

<body>

  <div class="topbar">
    <a class="brand" href="/multitenant"><span>&lt;</span>easyhostnet<span>/&gt;</span></a>
    <a class="topbar-link" href="/multitenant/signup"><span>New here?</span><strong>Create a store</strong></a>
  </div>

  <main class="hero">
    <h1>Log in to your store</h1>
    <p class="hero-sub">Manage your products, orders, and customers &mdash; from anywhere.</p>

    <form class="login-form" action="/multitenant/login" method="POST">

      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
        <div class="alert alert-success"><%= success_msg[0] %></div>
      <% } %>

      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
        <div class="alert alert-danger"><%= error_msg[0] %></div>
      <% } else if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-danger"><%= message %></div>
      <% } %>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="you@yourstore.com" required>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required>
      </div>

      <button type="submit" class="btn-submit">Log in</button>

      <div class="form-links">
        <a href="/multitenant/forgot-password">Forgot password?</a>
      </div>
    </form>

    <div class="signup-cta">
      Don&rsquo;t have a store yet? <a href="/multitenant/signup">Sign up for free</a>
    </div>
  </main>

</body>
</html>
